# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/build-content-bundle.mjs
/public/content/

# Synthetic photographs from scripts/generate-images.mjs. These ARE committed,
# because Cloudflare Pages builds from this repo and an uncommitted hero is a
# 404 on the live site. What made committing them unsafe was that a synthetic
# image was indistinguishable from a real one once rendered. It no longer is:
# every image under /public/generated/ renders beneath a "Generated stand-in"
# bar from src/components/GeneratedNotice.tsx, so the disclosure ships with the
# picture. Replace one with a real photograph the moment there is one.
#
# Placeholder tiles stay out. They are scaffolding, never meant to be seen.
/public/placeholder/
/contact-sheet.html
